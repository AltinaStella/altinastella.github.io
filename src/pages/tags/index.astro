---
import Base from '../../layouts/Base.astro';
import { countTags, getPosts, tagUrl } from '../../lib/posts';

const tags = countTags(await getPosts());
---

<Base title="标签" description="按标签浏览文章。">
  <div class="wrap">
    <h1 class="page-title">标签</h1>
    {
      tags.length > 0 ? (
        <ul class="tag-cloud">
          {tags.map(([tag, count]) => (
            <li>
              <a href={tagUrl(tag)}>
                #{tag}
                <span class="tag-count">{count} 篇</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">还没有标签。在文章的 frontmatter 里写上 tags 就会出现在这里。</p>
      )
    }
  </div>
</Base>

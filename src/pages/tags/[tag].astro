---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { countTags, getPosts, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return countTags(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`标签为「${tag}」的文章。`}>
  <div class="wrap">
    <h1 class="page-title">#{tag}</h1>
    <p class="page-lede">{posts.length} 篇文章。<a href={url('tags/')}>查看所有标签</a></p>
    <PostList posts={posts} />
  </div>
</Base>
